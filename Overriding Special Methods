class Rectangle:
   def __init__(self, width, height):
       self.width = width
       self.height = height
   def __str__(self):
       return f'Rectangle({self.width}, {self.height})'
class Square(Rectangle):
   def __init__(self, side):
       super().__init__(side, side)
   def __str__(self):
       return f'Square(side={self.width})'
square = Square(5)
print(square)
